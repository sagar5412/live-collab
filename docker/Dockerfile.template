# ============================================
# Example: Node.js Runner (Active)
# ============================================
FROM node:20-alpine

# Security: Create non-root user (use uid 1001 as 1000 may be in use)
RUN adduser -D -u 1001 runner || true

# Security: Remove unnecessary packages
RUN apk --no-cache add ca-certificates \
    && rm -rf /var/cache/apk/*

# Set working directory
WORKDIR /sandbox

# Switch to non-root user
USER runner

# Default entrypoint
ENTRYPOINT ["node"]

