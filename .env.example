# CollabPlay Environment Configuration
# Copy this file to .env and fill in your values

# ====================================
# WebSocket Configuration
# ====================================

# Yjs WebSocket server URL for document synchronization
# Default: ws://localhost:1234
VITE_WS_URL=ws://localhost:1234

# ====================================
# API Configuration  
# ====================================

# Backend API URL for code execution and room management
# Default: http://localhost:3001
VITE_API_URL=http://localhost:3001

# ====================================
# Application Settings
# ====================================

# Application name displayed in UI
VITE_APP_NAME=CollabPlay

# Enable debug mode for verbose logging
# Set to 'true' to enable
VITE_DEBUG=false

# ====================================
# Server Configuration (Backend)
# ====================================

# HTTP server port for Express + Socket.IO
PORT=3001

# Yjs WebSocket server port
YJS_PORT=1234

# ====================================
# Docker Execution Settings
# ====================================

# Enable Docker-based code execution
# Requires Docker to be installed and running
ENABLE_DOCKER=true

# Code execution timeout in milliseconds
# Default: 30000 (30 seconds)
EXECUTION_TIMEOUT=30000

# Docker memory limit for execution containers
# Default: 128m
DOCKER_MEMORY_LIMIT=128m

# Docker CPU limit for execution containers
# Default: 0.5 (half a CPU core)
DOCKER_CPU_LIMIT=0.5
